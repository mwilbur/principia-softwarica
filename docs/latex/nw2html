#!/usr/bin/env python3
"""nw2html: render a syncweb/noweb .nw book as a single navigable HTML page.

Pipeline: expand #include -> split doc/code chunks -> prose through pandoc
(-f latex) -> code chunks rendered with anchors + hyperlinked <<uses>>.
"""
import re, os, sys, html, subprocess

def load(path):
    lines = []
    base = os.path.dirname(path)
    for raw in open(path, encoding='utf-8', errors='replace'):
        m = re.match(r'#include\s+"(.+?\.nw)"', raw)
        if m:
            lines.extend(load(os.path.join(base, m.group(1))))
        else:
            lines.append(raw.rstrip('\n'))
    return lines

def parse(lines):
    """-> list of ('doc', [lines]) / ('code', name, [lines])"""
    segs, kind, name, buf = [], 'doc', None, []
    for line in lines:
        m = re.match(r'<<(.+)>>=\s*$', line)
        if m:
            segs.append((kind, name, buf)); kind, name, buf = 'code', m.group(1), []
        elif kind == 'code' and (line == '@' or line.startswith('@ ')):
            segs.append((kind, name, buf)); kind, name, buf = 'doc', None, []
            rest = line[1:].strip()
            if rest: buf.append(rest)
        else:
            buf.append(line)
    segs.append((kind, name, buf))
    return [s for s in segs if s[2] or s[0] == 'code']

def slug(name):
    return 'chk-' + re.sub(r'[^a-z0-9]+', '-', name.lower()).strip('-')

# prose macros from docs/latex/Macros.tex, restated so pandoc can expand them
PRELUDE = r'''
\newcommand{\co}[1]{\emph{#1}}
\newcommand{\cmd}[1]{\texttt{#1}}
\newcommand{\f}[1]{\texttt{#1}}
\newcommand{\book}[1]{\textsc{#1} book}
\newcommand{\nobook}[1]{\textsc{#1} book}
\newcommand{\furl}[1]{\footnote{\url{#1}}}
\newcommand{\repourl}[1]{Also available at \url{#1}}
\newcommand{\todo}[1]{}
\newcommand{\note}[1]{}
\newcommand{\less}[1]{}
\newcommand{\plan}{Plan~9\xspace}
\newcommand{\unix}{UNIX\xspace}
\newcommand{\principia}{Principia Softwarica\xspace}
\newcommand{\goken}{Goken\xspace}
\newcommand{\ocaml}{OCaml\xspace}
\newcommand{\xix}{XiX\xspace}
\newcommand{\att}{AT\&T\xspace}
\newcommand{\license}{All Rights Reserved License\xspace}
\newcommand{\urlprincipia}{\url{https://www.principia-softwarica.org/}\xspace}
\newcommand{\urlinstall}{\url{https://www.principia-softwarica.org/getting-started.html}\xspace}
\newcommand{\urlgoken}{\url{https://github.com/aryx/goken9cc}\xspace}
'''

def main(nwfile, outfile, title):
    segs = parse(load(nwfile))

    # def occurrences per chunk name, in order
    defs = {}
    for i, (kind, name, _) in enumerate(segs):
        if kind == 'code':
            defs.setdefault(name, []).append(i)

    # ---- build one latex doc; code chunks become sentinel paragraphs ----
    inline, tex = [], []
    def hide_inline(m):
        inline.append(m.group(1))
        return f'zQINLz{len(inline)-1}zENDz'
    for i, (kind, name, buf) in enumerate(segs):
        if kind == 'code':
            tex.append(f'\n\nzQCHUNKz{i}zENDz\n')
        else:
            # author's telegraphic annotation lines, not meant for rendering
            buf = [l for l in buf if not re.match(r'\\[ltn]\s', l)]
            t = '\n'.join(buf)
            t = re.sub(r'\[\[(.*?)\]\]', hide_inline, t, flags=re.S)
            t = re.sub(r'~?\\cite\{(.*?)\}', lambda m: f' [{m.group(1)}]', t)
            # images can't resolve in standalone HTML; options may span lines
            t = re.sub(r'\\includegraphics\s*(\[[^\]]*\])?\s*\{([^}]*)\}',
                       lambda m: f'\\emph{{[figure: {m.group(2)}]}}', t, flags=re.S)
            tex.append(t)
    body = '\n'.join(tex)
    cut = body.find(r'\chapter')
    if cut > 0: body = body[cut:]
    body = body.split(r'\end{document}')[0]
    body = body.replace(r'{vdiagram}', r'{verbatim}')
    body = PRELUDE + body

    p = subprocess.run(['pandoc', '-f', 'latex', '-t', 'html5', '--toc',
                        '--toc-depth=2', '-s', '--metadata', f'title={title}',
                        '--wrap=none'],
                       input=body, capture_output=True, text=True)
    if p.returncode != 0:
        sys.exit('pandoc failed:\n' + p.stderr[:3000])
    out = p.stdout

    # drop pandoc's built-in stylesheet; ours below owns the page
    out = re.sub(r'<style>(?:(?!</style>).)*max-width: 36em(?:(?!</style>).)*</style>\s*',
                 '', out, flags=re.S)

    # ---- restore [[inline code]] ----
    out = re.sub(r'zQINLz(\d+)zENDz',
                 lambda m: '<code>%s</code>' % html.escape(inline[int(m.group(1))]),
                 out)

    # ---- render code chunks in place of sentinels ----
    def link_uses(code):
        esc = html.escape(code)
        def repl(m):
            nm = m.group(1)
            if nm in defs:
                return f'<a class="use" href="#{slug(nm)}">&#x27E8;{html.escape(nm)}&#x27E9;</a>'
            return f'<span class="use">&#x27E8;{html.escape(nm)}&#x27E9;</span>'
        return re.sub(r'&lt;&lt;(.+?)&gt;&gt;', repl, esc)

    def render_chunk(m):
        i = int(m.group(1))
        _, name, buf = segs[i]
        occ = defs[name]; part = occ.index(i)
        anchor = slug(name) if part == 0 else f'{slug(name)}-{part+1}'
        hdr = f'<a class="def" href="#{anchor}">&#x27E8;{html.escape(name)}&#x27E9;</a>'
        hdr += '+&#x2261;' if part else '&#x2261;'
        if len(occ) > 1:
            nav = []
            for j in range(len(occ)):
                a = slug(name) if j == 0 else f'{slug(name)}-{j+1}'
                nav.append(f'<b>{j+1}</b>' if j == part else f'<a href="#{a}">{j+1}</a>')
            hdr += ' <span class="parts">[' + ' '.join(nav) + ']</span>'
        return (f'<div class="chunk" id="{anchor}"><div class="chunkhdr">{hdr}</div>'
                f'<pre>{link_uses(chr(10).join(buf))}</pre></div>')

    out = re.sub(r'<p>zQCHUNKz(\d+)zENDz</p>', render_chunk, out)
    out = re.sub(r'zQCHUNKz(\d+)zENDz', render_chunk, out)  # bare sentinels

    # matches the style of principia-softwarica.org
    style = '''<style>
    html{scroll-behavior:smooth}
    body{margin:2em 3em;
         font-family:Georgia,"Times New Roman",serif;line-height:1.5;
         color:#222;background:#fff}
    /* on wide screens, the TOC becomes a fixed sidebar */
    @media(min-width:90em){
      body{margin-left:26em}
      #TOC{position:fixed;top:0;left:0;bottom:0;width:20em;overflow-y:auto;
           margin:0;padding:1em 1.5em;border:none;border-right:1px solid #ddd}
    }
    h1,h2,h3{font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;line-height:1.2}
    h1{font-size:2em;margin-bottom:0.2em;margin-top:1.8em}
    h1.title{margin-top:0.5em}
    h2{font-size:1.4em;margin-top:1.5em}
    h3{font-size:1.1em;margin-top:1.2em}
    a{color:#0055aa} a:visited{color:#553388}
    ul{padding-left:1.5em} li{margin-bottom:0.3em}
    hr{border:none;border-top:1px solid #ccc;margin:2em 0}
    pre{font-family:"Courier New",Courier,monospace;font-size:0.85em;line-height:1.3;
        overflow-x:auto;background:#f8f8f8;padding:1em;border:1px solid #ddd}
    code{font-family:"Courier New",Courier,monospace;font-size:0.9em}
    table{border-collapse:collapse;font-size:0.95em;margin:1em 0}
    th,td{padding:0.3em 0.6em;border:1px solid #ccc;text-align:left}
    th{background:#f0f0f0}
    #TOC{font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;font-size:0.9em;
         background:#f8f8f8;border:1px solid #ddd;padding:0.5em 1.5em;margin:1.5em 0}
    #TOC ul{list-style:none;padding-left:1em}
    .chunk{margin:1.2em 0;border:1px solid #ddd}
    .chunk pre{margin:0;border:none}
    .chunkhdr{padding:0.25em 1em;font-style:italic;background:#f0f0f0;
              border-bottom:1px solid #ddd}
    .chunkhdr .parts{font-style:normal;font-size:0.85em;color:#777}
    .use{color:#0055aa;font-style:italic}
    :target{outline:2px solid #ffdd66}
    </style>'''
    out = out.replace('</head>', style + '</head>')
    open(outfile, 'w').write(out)
    ndefs = sum(1 for s in segs if s[0] == 'code')
    print(f'wrote {outfile}: {len(out)//1024} KB, {ndefs} code chunks, {len(defs)} unique chunk names')

if __name__ == '__main__':
    main(sys.argv[1], sys.argv[2], sys.argv[3] if len(sys.argv) > 3 else 'book')
