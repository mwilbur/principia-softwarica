#!/usr/bin/env python3
"""nw2html: render a syncweb/noweb .nw book as a single navigable HTML page.

Pipeline: expand #include -> split doc/code chunks -> prose through pandoc
(-f latex) -> code chunks rendered with anchors + hyperlinked <<uses>>.
"""
import re, os, sys, html, subprocess

def load(path):
    lines = []
    base = os.path.dirname(path)
    for raw in open(path, encoding='utf-8', errors='replace'):
        m = re.match(r'#include\s+"(.+?\.nw)"', raw)
        if m:
            lines.extend(load(os.path.join(base, m.group(1))))
        else:
            lines.append(raw.rstrip('\n'))
    return lines

def parse(lines):
    """-> list of ('doc', [lines]) / ('code', name, [lines])"""
    segs, kind, name, buf = [], 'doc', None, []
    for line in lines:
        m = re.match(r'<<(.+)>>=\s*$', line)
        if m:
            segs.append((kind, name, buf)); kind, name, buf = 'code', m.group(1), []
        elif kind == 'code' and (line == '@' or line.startswith('@ ')):
            segs.append((kind, name, buf)); kind, name, buf = 'doc', None, []
            rest = line[1:].strip()
            if rest: buf.append(rest)
        else:
            buf.append(line)
    segs.append((kind, name, buf))
    return [s for s in segs if s[2] or s[0] == 'code']

def slug(name):
    return 'chk-' + re.sub(r'[^a-z0-9]+', '-', name.lower()).strip('-')

def main(nwfile, outfile, title):
    segs = parse(load(nwfile))

    # def occurrences per chunk name, in order
    defs = {}
    for i, (kind, name, _) in enumerate(segs):
        if kind == 'code':
            defs.setdefault(name, []).append(i)

    # ---- build one latex doc; code chunks become sentinel paragraphs ----
    inline, tex = [], []
    def hide_inline(m):
        inline.append(m.group(1))
        return f'zQINLz{len(inline)-1}zENDz'
    for i, (kind, name, buf) in enumerate(segs):
        if kind == 'code':
            tex.append(f'\n\nzQCHUNKz{i}zENDz\n')
        else:
            # author's telegraphic annotation lines, not meant for rendering
            buf = [l for l in buf if not re.match(r'\\[ltn]\s', l)]
            t = '\n'.join(buf)
            t = re.sub(r'\[\[(.*?)\]\]', hide_inline, t, flags=re.S)
            t = re.sub(r'~?\\cite\{(.*?)\}', lambda m: f' [{m.group(1)}]', t)
            # images can't resolve in standalone HTML; options may span lines
            t = re.sub(r'\\includegraphics\s*(\[[^\]]*\])?\s*\{([^}]*)\}',
                       lambda m: f'\\emph{{[figure: {m.group(2)}]}}', t, flags=re.S)
            tex.append(t)
    body = '\n'.join(tex)
    cut = body.find(r'\chapter')
    if cut > 0: body = body[cut:]
    body = body.split(r'\end{document}')[0]

    p = subprocess.run(['pandoc', '-f', 'latex', '-t', 'html5', '--toc',
                        '--toc-depth=2', '-s', '--metadata', f'title={title}',
                        '--wrap=none'],
                       input=body, capture_output=True, text=True)
    if p.returncode != 0:
        sys.exit('pandoc failed:\n' + p.stderr[:3000])
    out = p.stdout

    # drop pandoc's built-in stylesheet; ours below owns the page
    out = re.sub(r'<style>(?:(?!</style>).)*max-width: 36em(?:(?!</style>).)*</style>\s*',
                 '', out, flags=re.S)

    # ---- restore [[inline code]] ----
    out = re.sub(r'zQINLz(\d+)zENDz',
                 lambda m: '<code>%s</code>' % html.escape(inline[int(m.group(1))]),
                 out)

    # ---- render code chunks in place of sentinels ----
    def link_uses(code):
        esc = html.escape(code)
        def repl(m):
            nm = m.group(1)
            if nm in defs:
                return f'<a class="use" href="#{slug(nm)}">&#x27E8;{html.escape(nm)}&#x27E9;</a>'
            return f'<span class="use">&#x27E8;{html.escape(nm)}&#x27E9;</span>'
        return re.sub(r'&lt;&lt;(.+?)&gt;&gt;', repl, esc)

    def render_chunk(m):
        i = int(m.group(1))
        _, name, buf = segs[i]
        occ = defs[name]; part = occ.index(i)
        anchor = slug(name) if part == 0 else f'{slug(name)}-{part+1}'
        hdr = f'<a class="def" href="#{anchor}">&#x27E8;{html.escape(name)}&#x27E9;</a>'
        hdr += '+&#x2261;' if part else '&#x2261;'
        if len(occ) > 1:
            nav = []
            for j in range(len(occ)):
                a = slug(name) if j == 0 else f'{slug(name)}-{j+1}'
                nav.append(f'<b>{j+1}</b>' if j == part else f'<a href="#{a}">{j+1}</a>')
            hdr += ' <span class="parts">[' + ' '.join(nav) + ']</span>'
        return (f'<div class="chunk" id="{anchor}"><div class="chunkhdr">{hdr}</div>'
                f'<pre>{link_uses(chr(10).join(buf))}</pre></div>')

    out = re.sub(r'<p>zQCHUNKz(\d+)zENDz</p>', render_chunk, out)
    out = re.sub(r'zQCHUNKz(\d+)zENDz', render_chunk, out)  # bare sentinels

    style = '''<style>
    html{scroll-behavior:smooth;background:#fdfdfa}
    body{max-width:52rem;margin:0 auto;padding:1rem 1.5rem;font:17px/1.55 Georgia,serif;color:#1a1a1a;background:#fdfdfa}
    h1.title{border-bottom:none;text-align:center;margin-top:1em}
    blockquote{margin:1em 2em;font-style:italic}
    table{border-collapse:collapse} td,th{border:1px solid #999;padding:.2em .6em}
    h1{margin-top:2.5em;border-bottom:2px solid #888;padding-bottom:.2em}
    h2{margin-top:1.8em}
    code{font:14px/1.4 "Lucida Console",Menlo,monospace;background:#f0efe8;padding:0 .2em;border-radius:3px}
    #TOC{background:#f4f3ec;border:1px solid #ddd;border-radius:6px;padding:.5em 1.5em;font-family:Verdana,sans-serif;font-size:14px}
    #TOC ul{list-style:none;padding-left:1em}
    .chunk{margin:1.2em 0;border-left:3px solid #7a9;background:#f6f8f6;border-radius:0 6px 6px 0}
    .chunk pre{margin:0;padding:.6em .9em;overflow-x:auto;font:13.5px/1.45 "Lucida Console",Menlo,monospace}
    .chunkhdr{padding:.25em .9em;font:italic 14px Georgia,serif;background:#e8efe9;border-radius:0 6px 0 0}
    .chunkhdr .parts{font-style:normal;font-size:12px;color:#567}
    a{color:#26619c;text-decoration:none} a:hover{text-decoration:underline}
    .use{color:#26619c;font-style:italic}
    :target{outline:3px solid #f5c542}
    @media(prefers-color-scheme:dark){
      html{background:#191a17}
      body{background:#191a17;color:#ddd}
      code{background:#2a2b27}
      #TOC{background:#22231f;border-color:#333}
      .chunk{background:#20241f;border-left-color:#4a6}
      .chunkhdr{background:#283029}
      a,.use{color:#7fb3e8}
    }
    </style>'''
    out = out.replace('</head>', style + '</head>')
    open(outfile, 'w').write(out)
    ndefs = sum(1 for s in segs if s[0] == 'code')
    print(f'wrote {outfile}: {len(out)//1024} KB, {ndefs} code chunks, {len(defs)} unique chunk names')

if __name__ == '__main__':
    main(sys.argv[1], sys.argv[2], sys.argv[3] if len(sys.argv) > 3 else 'book')
